rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       USERS
       ============================================================ */

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       STUDENTS
       ============================================================ */

    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       FACULTY
       ============================================================ */

    match /faculty/{facultyId} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       ACADEMIC DATA
       ============================================================ */

    match /subjects/{id} {
      allow read, write: if request.auth != null;
    }

    match /attendance/{id} {
      allow read, write: if request.auth != null;
    }

    match /timetable/{id} {
      allow read, write: if request.auth != null;
    }

    match /assignments/{id} {
      allow read, write: if request.auth != null;
    }

    match /submissions/{id} {
      allow read, write: if request.auth != null;
    }

    match /exams/{id} {
      allow read, write: if request.auth != null;
    }

    match /results/{id} {
      allow read, write: if request.auth != null;
    }

    match /fees/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       PUBLIC WEBSITE COLLECTIONS
       ============================================================ */

    match /notices/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /* ============================================================
       OTHER SCMS COLLECTIONS
       ============================================================ */

    match /departments/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /courses/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /notifications/{id} {
      allow read, write: if request.auth != null;
    }

    match /leaveRequests/{id} {
      allow read, write: if request.auth != null;
    }

    match /complaints/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       ADMIN QUERIES
       ============================================================ */

    match /queries/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       ADMIN REPORTS
       ============================================================ */

    match /reports/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       ADMIN MESSAGES
       ============================================================ */

    match /messages/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       AUDIT LOGS
       ============================================================ */

    match /auditLogs/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       SYSTEM SETTINGS
       ============================================================ */

    match /settings/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       CERTIFICATES
       ============================================================ */

    match /certificates/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       MATERIALS
       ============================================================ */

    match /materials/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       LIBRARY
       ============================================================ */

    match /library/{id} {
      allow read, write: if request.auth != null;
    }

    /* ============================================================
       DEFAULT DENY
       ============================================================ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

