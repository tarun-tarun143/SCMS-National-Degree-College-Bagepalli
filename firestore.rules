rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return userExists() && userDoc().role == 'admin' && userDoc().status == 'active'; }
    function isFaculty() { return userExists() && userDoc().role == 'faculty' && userDoc().status == 'active'; }
    function isStudent() { return userExists() && userDoc().role == 'student' && userDoc().status == 'active'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'pending'
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'phone', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    match /students/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.userId == request.auth.uid) || isFaculty();
      allow write: if isAdmin();
    }

    match /faculty/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{id} { allow read, write: if isAdmin(); }

    match /courses/{id} { allow read: if true; allow write: if isAdmin(); }
    match /departments/{id} { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /academicYears/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /semesters/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /sections/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /timetables/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    match /attendance/{id} {
      allow read: if isAdmin() || (isStudent() && resource.data.userId == request.auth.uid) || isFaculty();
      allow write: if isAdmin() || isFaculty();
    }

    match /assignments/{id} { allow read: if signedIn(); allow write: if isAdmin() || isFaculty(); }
    match /submissions/{id} { allow read, write: if signedIn(); }
    match /studyMaterials/{id} { allow read: if signedIn(); allow write: if isAdmin() || isFaculty(); }
    match /exams/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /examSchedules/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /marks/{id} { allow read: if signedIn(); allow write: if isAdmin() || isFaculty(); }
    match /results/{id} { allow read: if signedIn(); allow write: if isAdmin() || isFaculty(); }
    match /fees/{id} { allow read: if isAdmin() || (isStudent() && resource.data.userId == request.auth.uid); allow write: if isAdmin(); }
    match /feePayments/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /notices/{id} { allow read: if resource.data.status == 'published' || isAdmin(); allow write: if isAdmin(); }
    match /events/{id} { allow read: if true; allow write: if isAdmin(); }
    match /eventRegistrations/{id} { allow read, write: if signedIn(); }
    match /leaveRequests/{id} { allow read, write: if signedIn(); }
    match /certificateRequests/{id} { allow read, write: if signedIn(); }
    match /messages/{id} { allow read, write: if signedIn(); }
    match /conversations/{id} { allow read, write: if signedIn(); }
    match /notifications/{id} { allow read: if signedIn(); allow write: if isAdmin() || isFaculty(); }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if isAdmin() || isFaculty(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
  }
}