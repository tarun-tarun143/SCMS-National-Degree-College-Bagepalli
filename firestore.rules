rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================================================
    // HELPER FUNCTIONS
    // ==================================================

    function signedIn() {
      return request.auth != null;
    }

    function ownUser(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function activeUser() {
      return signedIn()
        && userDoc().data.status == "active";
    }

    function isAdmin() {
      return activeUser()
        && userDoc().data.role == "admin";
    }

    function isFaculty() {
      return activeUser()
        && userDoc().data.role == "faculty";
    }

    function isStudent() {
      return activeUser()
        && userDoc().data.role == "student";
    }


    // ==================================================
    // USERS / PROFILES
    // ==================================================

    match /users/{userId} {

      // A user can read their own profile.
      // Admin can read all profiles.
      allow read: if ownUser(userId)
        || isAdmin();

      // New Google users can create only their own
      // pending profile.
      allow create: if ownUser(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "pending"
        && request.resource.data.status == "pending";

      // Users can update only permitted profile fields.
      // Role, status, UID, email and college-managed
      // identifiers remain protected.
      allow update: if ownUser(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "name",
            "phone",
            "photoData",
            "photoURL",
            "dateOfBirth",
            "gender",
            "address",
            "city",
            "state",
            "pinCode",
            "guardianName",
            "guardianPhone",
            "emergencyContact",
            "designation",
            "qualification",
            "specialization",
            "experience",
            "updatedAt"
          ]);

      // Admin can fully manage users.
      allow update, delete: if isAdmin();
    }


    // ==================================================
    // NOTICES
    // ==================================================

    match /notices/{document} {

      // Public website can read only published notices.
      allow read: if resource.data.status == "published";

      // Admin manages notices.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // COURSES
    // ==================================================

    match /courses/{document} {

      // Public website.
      allow read: if true;

      // Admin only.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // DEPARTMENTS
    // ==================================================

    match /departments/{departmentId} {

      // Public website realtime listener.
      allow read: if true;

      // Admin only.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // EVENTS
    // ==================================================

    match /events/{document} {

      // Public website realtime listener.
      allow read: if true;

      // Admin only.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // CONTACT QUERIES
    // ==================================================

    match /queries/{queryId} {

      // Only active admins can read queries.
      allow read: if isAdmin();

      // Queries are written through the Next.js server API
      // using Firebase Admin SDK.
      allow create, update, delete: if false;
    }


    // ==================================================
    // ATTENDANCE
    // ==================================================

    match /attendance/{attendanceId} {

      // Admin sees everything.
      allow read: if isAdmin();

      // Faculty sees attendance they marked.
      allow read: if isFaculty()
        && resource.data.facultyId == request.auth.uid;

      // Students see only their own attendance.
      allow read: if isStudent()
        && resource.data.studentUserId == request.auth.uid;

      // Admin can fully manage attendance.
      allow create, update, delete: if isAdmin();

      // Faculty can create attendance under own UID.
      allow create: if isFaculty()
        && request.resource.data.facultyId == request.auth.uid
        && request.resource.data.markedBy == request.auth.uid;

      // Faculty can update only their own attendance.
      allow update: if isFaculty()
        && resource.data.facultyId == request.auth.uid
        && request.resource.data.facultyId == request.auth.uid;

      // Faculty cannot delete attendance.
      allow delete: if false;
    }


    // ==================================================
    // STUDENTS
    // ==================================================

    match /students/{studentId} {

      // Admin and faculty can read student records.
      // Students can read only their own record.
      allow read: if isAdmin()
        || isFaculty()
        || (
          isStudent()
          && resource.data.userId == request.auth.uid
        );

      // Admin manages student records.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // FACULTY
    // ==================================================

    match /faculty/{facultyId} {

      // Admin can see all faculty.
      // Faculty can see their own profile record.
      allow read: if isAdmin()
        || (
          isFaculty()
          && resource.data.userId == request.auth.uid
        );

      // Admin manages faculty records.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // SUBJECTS
    // ==================================================

    match /subjects/{subjectId} {

      // Active academic users can read subjects.
      allow read: if isAdmin()
        || isFaculty()
        || isStudent();

      // Admin manages subjects.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // TIMETABLE
    // ==================================================

    match /timetable/{document} {

      // Active academic users can read timetable.
      allow read: if isAdmin()
        || isFaculty()
        || isStudent();

      // Admin manages timetable.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // ASSIGNMENTS
    // ==================================================

    match /assignments/{assignmentId} {

      // Active users can read assignments.
      allow read: if isAdmin()
        || isFaculty()
        || isStudent();

      // Admin and faculty can manage assignments.
      allow create, update, delete: if isAdmin()
        || isFaculty();
    }


    // ==================================================
    // SUBMISSIONS
    // ==================================================

    match /submissions/{submissionId} {

      // Admin and faculty see all submissions.
      // Student sees only their own submission.
      allow read: if isAdmin()
        || isFaculty()
        || (
          isStudent()
          && resource.data.studentUserId == request.auth.uid
        );

      // Student can create only their own submission.
      allow create: if isStudent()
        && request.resource.data.studentUserId == request.auth.uid;

      // Admin and faculty can update.
      // Student can update only their own submission.
      allow update: if isAdmin()
        || isFaculty()
        || (
          isStudent()
          && resource.data.studentUserId == request.auth.uid
        );

      // Only admin can delete.
      allow delete: if isAdmin();
    }


    // ==================================================
    // EXAMS
    // ==================================================

    match /exams/{examId} {

      // Active academic users can read exams.
      allow read: if isAdmin()
        || isFaculty()
        || isStudent();

      // Admin manages exams.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // RESULTS / MARKS
    // ==================================================

    match /results/{resultId} {

      // Admin and faculty can read all results.
      // Student can read only their own result.
      allow read: if isAdmin()
        || isFaculty()
        || (
          isStudent()
          && resource.data.studentUserId == request.auth.uid
        );

      // Admin and faculty can manage results.
      allow create, update, delete: if isAdmin()
        || isFaculty();
    }


    // ==================================================
    // FEES
    // ==================================================

    match /fees/{feeId} {

      // Admin can see all fees.
      // Student can see only their own fees.
      allow read: if isAdmin()
        || (
          isStudent()
          && resource.data.studentUserId == request.auth.uid
        );

      // Admin manages fees.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // LEAVE REQUESTS
    // ==================================================

    match /leaves/{leaveId} {

      // Admin and faculty can read all leave requests.
      // Student sees only their own.
      allow read: if isAdmin()
        || isFaculty()
        || (
          isStudent()
          && resource.data.studentUserId == request.auth.uid
        );

      // Student can create only their own leave request.
      allow create: if isStudent()
        && request.resource.data.studentUserId == request.auth.uid;

      // Admin and faculty can update.
      // Student can update only their own.
      allow update: if isAdmin()
        || isFaculty()
        || (
          isStudent()
          && resource.data.studentUserId == request.auth.uid
        );

      // Only admin can delete.
      allow delete: if isAdmin();
    }


    // ==================================================
    // NOTIFICATIONS
    // ==================================================

    match /notifications/{notificationId} {

      // Admin can read all notifications.
      // Users can read only their own.
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // Admin manages notifications.
      allow create, update, delete: if isAdmin();
    }


    // ==================================================
    // AUDIT LOGS
    // ==================================================

    match /auditLogs/{logId} {

      // Admin can read audit logs.
      allow read: if isAdmin();

      // Audit logs are server-side only.
      allow create, update, delete: if false;
    }

  }
}
